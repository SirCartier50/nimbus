# ============================================================
# Nimbus AI — Root environment variables
# Used by docker-compose to inject secrets at runtime
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Clerk (frontend auth) ---
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# --- Backend AWS credentials ---
# These are also in backend/.env — set them there for local non-Docker dev
# For Docker, docker-compose reads backend/.env directly
# (Kept here for reference only)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# AWS_REGION=us-east-1
