# Nimbus's OWN AWS service identity — NOT a user's credentials. This is the
# "trusting" principal that calls sts:AssumeRole into each user's IAM role (see
# infra/nimbus-cross-account-role.yaml). Users never give Nimbus a long-lived key;
# per-user access is entirely via short-lived STS credentials (utils/aws_role.py).
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Must match the ARN of the identity above — baked into the CloudFormation template's
# trust policy as the default NimbusPrincipalArn parameter. Only needed if you want to
# override the fallback default in routes/settings.py.
NIMBUS_PRINCIPAL_ARN=arn:aws:iam::your_account_id:user/your_service_user

# Supabase Postgres — use the Session Pooler URI (port 5432), not the direct
# db.<ref>.supabase.co host (that one is IPv6-only and won't resolve on most networks).
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_password@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Clerk — get issuer from Clerk Dashboard → JWT Templates or API Keys page
# Example: https://your-app-id.clerk.accounts.dev
CLERK_ISSUER=https://your-app-id.clerk.accounts.dev

# Comma-separated list of allowed frontend origins (default: localhost only)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM provider: openrouter (default) | groq | huggingface
# Every option must use a model that supports tool/function calling — every
# Nimbus agent depends on it. See PIPELINE_PLAN.md §5.
LLM_PROVIDER=openrouter
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# HuggingFace Inference Providers (OpenAI-compatible router) — https://huggingface.co/settings/tokens
# Pick a TOOL-CAPABLE model (e.g. deepseek-ai/DeepSeek-V3-0324, Qwen/Qwen2.5-72B-Instruct,
# meta-llama/Llama-3.3-70B-Instruct); many HF models can't tool-call and will break the agents.
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V3-0324

# ── Optional infrastructure / tuning (sane defaults when unset) ──────────────

# Redis: shared rate limits, STS-credential cache, dashboard cache across
# workers. Unset = in-process fallbacks (fine for a single process).
# docker-compose.yml sets this to the bundled redis service.
#REDIS_URL=redis://localhost:6379/0

# Whether THIS API process runs the Bodyguard patrol loop (default true for
# bare dev runs). Compose sets false and runs worker.py as its own service.
#BODYGUARD_IN_API=true

# Spend guardrails: max chat turns per user per UTC day (0 disables).
#DAILY_TURN_LIMIT=100
# Per-minute request limits (see ratelimit.py)
#RATE_LIMIT_CHAT_PER_MINUTE=10
#RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Turn execution (see routes/chat.py)
#MAX_CONCURRENT_TURNS=8
#TURN_TIMEOUT_SECONDS=1800
#SHUTDOWN_DRAIN_SECONDS=55

# DB pool (see db/engine.py)
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=5

# Observability: LOG_FORMAT=json for structured logs (compose sets it);
# SENTRY_DSN enables error tracking (off when unset).
#LOG_FORMAT=text
#LOG_LEVEL=INFO
#SENTRY_DSN=
