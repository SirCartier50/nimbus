AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Clerk — get issuer from Clerk Dashboard → JWT Templates or API Keys page
# Example: https://your-app-id.clerk.accounts.dev
CLERK_ISSUER=https://your-app-id.clerk.accounts.dev

# Comma-separated list of allowed frontend origins (default: localhost only)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
